printfn "Enter Marks of Four Subjects: "

let marks1 = int (System.Console.ReadLine())
let marks2 = int (System.Console.ReadLine())
let marks3 = int (System.Console.ReadLine())
let marks4 = int (System.Console.ReadLine())

let percentageMarks = float (marks1 + marks2 + marks3 + marks4) / 4.0


let divison = 
    match percentageMarks with
    | p when p >= 60.0 -> "First Division"
    | p when p >= 50.0 -> "Second Divison"
    | p when p >= 40.0 -> "Third Division"
    | _ -> "Fail"

printfn "Percentage = %.2f%%" percentageMarks

printfn "%s" divison

Q2
let isPrime n =
    if n < 2 then false
    else
        [2 .. n-1]
        |> List.filter(fun i -> n % i = 0)
        |> List.isEmpty

printfn "%b" (isPrime 3)
printfn "%b" (isPrime 7)
printfn "%b" (isPrime 10)
printfn "%b" (isPrime 17)

Q3
let reverse (s: string) =
    s.ToCharArray() |> Array.rev |> System.String

let palindrome (s: string) =
    s = reverse s

printfn "Reverse: %s" (reverse "madam")
printfn "Palindrome: %b" (palindrome "madam")
printfn "Palindrome: %b" (palindrome "hello")

let transform (s: string) =
    if s <> "" && (s |> Seq.forall System.Char.IsLetter) then
        s.ToUpper()
    elif s <> "" && (s |> Seq.forall System.Char.IsDigit) then
        s + s
    else
        s

printfn "Result: %s" (transform "diwakar")
printfn "Result: %s" (transform "456")
printfn "Result: %s" (transform "diwakar1122")

let emailCheck (s: string) =
    let parts = s.Split('@')
    parts.Length = 2 && parts.[0] <> "" && parts.[1].Contains(".")

printfn "Email: %b" (emailCheck "diwakar@gmail.com")
printfn "Email: %b" (emailCheck "diwakar567@yahoo.com")
printfn "Email: %b" (emailCheck "invalid")
